# Set these on the Python API host, never in VITE_* variables.
HF_TOKEN=
SAM_MODEL=facebook/sam-audio-base
SAM_DEVICE=cuda
# cuda/auto: choose an available GPU for each job; cuda:1: pin a visible device.
SAM_MIN_FREE_GB=12
SAM_MAX_GPU_UTILIZATION=10
SAM_CHUNK_SECONDS=20
MAX_AUDIO_SECONDS=600
MAX_UPLOAD_MB=200
AKBO_DATA_DIR=.data
LYRICS_MODEL=base
# Optional ADT_STR worker, provisioned separately; never install it into SAM's env.
# Leave unset to use the experimental three-class CPU drum detector.
# Paths must refer to a trusted checkout and a complete local HF-format model.
# Prepare with requirements-drum.txt and scripts/prepare-drum-model.py (README).
# Model card has no separate weight license: review terms before public deployment.
# AKBO_DRUM_WORKER=/absolute/path/to/drum-venv/bin/python
# AKBO_DRUM_SOURCE_DIR=/absolute/path/to/ADT_STR
# AKBO_DRUM_MODEL_DIR=/absolute/path/to/model/setting-tau-0.8
# AKBO_DRUM_DEVICE=cpu
# Defaults preserve the original ADT route. The explicit hybrid engine always
# uses peak + greedy + 1 pass; consensus uses peak + greedy + 3 passes,
# independent of these diagnostic overrides. Auto/neural remain 1 pass by default.
# AKBO_DRUM_NORMALIZATION=none
# AKBO_DRUM_DECODING=greedy
# AKBO_DRUM_CONTEXT_PASSES=1
# Experimental only: constrained decoding limits duplicate-token loops, but
# did not improve development F1 over greedy; do not enable as a quality fix.
# Experimental only: AKBO_DRUM_DECODING=guarded retries malformed chunks once,
# accepting at most one forced token and retaining rejected original evidence.
# This still regressed a real recording: NOT a recommended accuracy setting.
# Hybrid/consensus retain their existing greedy decoder regardless of this override.
# Explicit opt-out for sample-only development; full readiness is required by default.
# AKBO_ALLOW_DEGRADED=1
